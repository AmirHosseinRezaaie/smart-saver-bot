# Copy this file to .env and fill in real values locally.
# Never commit .env or any file containing a real secret.

# One of: development, staging, production, testing
ENVIRONMENT=development

# Human-readable app metadata, shown in OpenAPI/Swagger UI.
APP_NAME=Smart Saver Bot
APP_VERSION=0.2.0-dev

# Verbose errors / auto-reload. Must be false when ENVIRONMENT=production
# (enforced at startup — see app/core/config.py).
DEBUG=true

# Bale bot token (Phase 5+: consumed by the bot layer)
BALE_BOT_TOKEN=YOUR_BOT_TOKEN

# PostgreSQL connection string (async driver: postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:********@localhost:5432/shopping_bot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis connection string (Phase 2+: consumed by cache infrastructure)
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5

# OKALA data provider (Phase 3+). No default base URL is shipped in code —
# see docs/okala-research.md before setting this to anything real.
OKALA_PROVIDER_BASE_URL=
OKALA_REQUEST_TIMEOUT=10
OKALA_MAX_ATTEMPTS=3
OKALA_RETRY_BACKOFF=0.5
OKALA_MIN_REQUEST_INTERVAL=1
OKALA_USER_AGENT=SmartSaverBot/0.3
OKALA_SNAPSHOT_ENABLED=false
OKALA_SNAPSHOT_DIR=raw_snapshots
