# Copy this file to .env and fill in real values locally.
# Never commit .env or any file containing a real secret.

# Bale bot token (Phase 2+: consumed by the bot layer)
BALE_BOT_TOKEN=YOUR_BOT_TOKEN

# PostgreSQL connection string (Phase 2+: consumed by the database layer)
DATABASE_URL=postgresql://user:password@localhost:5432/shopping_bot

# Redis connection string (Phase 2+: consumed by cache/queue layers)
REDIS_URL=redis://localhost:6379/0

# One of: development, staging, production, testing
ENVIRONMENT=development
